/**
 * @file Firebase Security Rules for CodeReview Console.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model where admins have broad access and candidates primarily access their own data.
 * Ownership is enforced through path-based checks, especially for submissions.
 *
 * Data Structure:
 * - /admins/{adminId}: Stores administrator profiles.
 * - /candidates/{candidateId}: Stores candidate profiles.
 * - /problems/{problemId}: Stores coding problems.
 * - /candidates/{candidateId}/submissions/{submissionId}: Stores code submissions by candidates.
 *
 * Key Security Decisions:
 * - Admin role is determined by checking the existence of an admin document.
 * - Candidates can only access their own profile data.
 * - Candidates can only access their own submissions.
 * - Problems are publicly readable but only modifiable by admins.
 *
 * Denormalization for Authorization:
 * - Submissions are stored under the candidate document to easily check ownership via the path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants admins full access to admin profiles.
     * @path /admins/{adminId}
     * @allow (get, list) User with admin role can read admin profile data.
     * @allow (create) User with admin role OR any authenticated user if they are creating their own doc and no admins exist.
     * @allow (update, delete) User with admin role can modify admin profile data.
     * @deny (get, list) User without admin role cannot read admin profile data.
     * @deny (create, update, delete) User without admin role cannot modify admin profile data (with exception for initial admin).
     * @principle Enforces admin-only access to admin profiles, with a bootstrap mechanism for the first admin.
     */
    match /admins/{adminId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isCreatingInitialAdmin(adminId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Grants candidates access to their own profiles.
     * @path /candidates/{candidateId}
     * @allow (get) Authenticated user can read their own profile data.
     * @allow (list) Authenticated user can list their own profile data.
     * @allow (create) Authenticated user can create their own profile.
     * @allow (update) Authenticated user can update their own profile.
     * @allow (delete) Authenticated user can delete their own profile.
     * @deny (get) Authenticated user cannot read another user's profile data.
     * @deny (list) Authenticated user cannot list another user's profile data.
     * @deny (create) Authenticated user cannot create profile with different ID.
     * @deny (update) Authenticated user cannot update another user's profile data.
     * @deny (delete) Authenticated user cannot delete another user's profile data.
     * @principle Enforces document ownership for candidate profiles.
     */
    match /candidates/{candidateId} {
      allow get: if isOwner(candidateId);
      allow list: if isOwner(candidateId);
      allow create: if isOwner(candidateId);
      allow update: if isOwner(candidateId);
      allow delete: if isOwner(candidateId);
    }

    /**
     * @description Grants admins CRUD access to problems, and public read access.
     * @path /problems/{problemId}
     * @allow (get, list) Any user can read problems.
     * @allow (create, update, delete) User with admin role can modify problems.
     * @deny (create, update, delete) User without admin role cannot modify problems.
     * @principle Enforces admin-only writes for problems.
     */
    match /problems/{problemId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Grants candidates access to their own submissions, and admins access to all submissions.
     * @path /candidates/{candidateId}/submissions/{submissionId}
     * @allow (get, list) Authenticated user can read/list their own submissions.
     * @allow (create) Authenticated user can create submissions under their own profile.
     * @allow (update, delete) Authenticated user can update/delete their own submissions.
     * @deny (get, list, create, update, delete) Authenticated user cannot access another user's submissions.
     * @principle Enforces document ownership for submissions, with admin override.
     */
    match /candidates/{candidateId}/submissions/{submissionId} {
      allow get: if isOwner(candidateId) || isAdmin();
      allow list: if isOwner(candidateId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.candidateId == candidateId;
      allow update: if (isExistingOwner(candidateId) && request.resource.data.candidateId == resource.data.candidateId) || isAdmin();
      allow delete: if isExistingOwner(candidateId) || isAdmin();
    }

    /**
     * @description Checks if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the document based on the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the document and the document exists.  Useful for update/delete checks.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the current user has the admin role.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    /**
     * @description Checks if an admin is being created for the first time.
     * @return {boolean} True if no admin docs exist and the user is creating their own admin doc.
     */
    function isCreatingInitialAdmin(adminId) {
      return isOwner(adminId) && !exists(/databases/$(database)/documents/admins);
    }
  }
}
